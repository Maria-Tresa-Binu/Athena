# Optional comma-separated RSS feeds for the news tool.
ATHENA_NEWS_FEEDS=https://feeds.arstechnica.com/arstechnica/technology-lab,https://techcrunch.com/feed/
ATHENA_LLM_MODEL=openai:gpt-4o-mini
# Optional MCP server URL, for example http://localhost:8001/mcp
ATHENA_MCP_URL=
# Or provide multiple servers as JSON:
# ATHENA_MCP_SERVERS_JSON={"calendar":{"transport":"http","url":"http://localhost:8001/mcp"}}
